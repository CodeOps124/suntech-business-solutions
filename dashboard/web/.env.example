# Copy to .env.local to connect the LIVE AWS QuickSight dashboard instead of the
# local sample-data preview. All four must be set for the Analytics page to embed
# the real dashboard; the Settings → AWS Connection panel shows live status.
# Connecting is config-only — no code changes. See CONNECT_AWS.md.

# Must be me-central-1 (UAE / Dubai) for data residency.
VITE_AWS_REGION=
VITE_AWS_ACCOUNT_ID=
VITE_QS_DASHBOARD_ID=suntech-pnl-invoice-analytics

# URL of the embed-URL backend in ./server (e.g. http://localhost:8787/embed-url).
# It mints a principal-scoped embed URL so QuickSight RLS applies server-side.
VITE_QS_EMBED_ENDPOINT=

# Django backend API base. Default is http://localhost:8000/api. The app
# auto-detects whether it's reachable; if not, it falls back to bundled sample
# data (top-bar badge shows which source is live).
VITE_API_BASE=http://localhost:8000/api
